{
  "manifest_version": 3,
  "name": "Kueski Widget Pro",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["activeTab", "scripting", "tabs", "notifications", "alarms", "storage", "offscreen"],
  "host_permissions": [
    "*://*.amazon.com.mx/*",
    "*://*.amazon.com/*",
    "*://*.bodegaaurrera.com.mx/*",
    "*://bodegaaurrera.com.mx/*",
    "*://*.shein.com.mx/*",
    "*://shein.com.mx/*",
    "*://*.temu.com/*",
    "*://temu.com/*",
    "*://*.innovasport.com/*",
    "*://innovasport.com/*",
    "*://*.levi.com.mx/*",
    "*://levi.com.mx/*",
    "*://*.adidas.mx/*",
    "*://adidas.mx/*",
    "*://*.samsung.com.mx/*",
    "*://samsung.com.mx/*",
    "*://mx.puma.com/*",
    "*://*.stevemadden.com.mx/*",
    "*://stevemadden.com.mx/*",
    "*://*.innvictus.com/*",
    "*://innvictus.com/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com.mx/*", "*://*.amazon.com/*", "*://*.bodegaaurrera.com.mx/*", "*://bodegaaurrera.com.mx/*"],
      "matches": [
        "*://*.amazon.com.mx/*",
        "*://*.amazon.com/*",
        "*://*.bodegaaurrera.com.mx/*",
        "*://bodegaaurrera.com.mx/*",
        "*://*.shein.com.mx/*",
        "*://shein.com.mx/*",
        "*://*.temu.com/*",
        "*://temu.com/*",
        "*://*.innovasport.com/*",
        "*://innovasport.com/*",
        "*://*.levi.com.mx/*",
        "*://levi.com.mx/*",
        "*://*.adidas.mx/*",
        "*://adidas.mx/*",
        "*://*.samsung.com.mx/*",
        "*://samsung.com.mx/*",
        "*://mx.puma.com/*",
        "*://*.stevemadden.com.mx/*",
        "*://stevemadden.com.mx/*",
        "*://*.innvictus.com/*",
        "*://innvictus.com/*"
      ],
      "js": ["assets/content.js"], 
      "run_at": "document_idle"
    }
  ]
}
